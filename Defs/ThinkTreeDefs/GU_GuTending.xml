    Each Gu Master can switch it off on the Aperture tab's Gu page.
  -->
  <ThinkTreeDef>
    <defName>GU_TendOwnGu</defName>
    <insertTag>Humanlike_PreMain</insertTag>
    <insertPriority>40</insertPriority>
    <thinkRoot Class="ThinkNode_ConditionalColonist">
      <subNodes>
        <li Class="ProjectGu.Sustenance.JobGiver_GuTendOwnGu" />
      </subNodes>
    </thinkRoot>
  </ThinkTreeDef>
</Defs>
