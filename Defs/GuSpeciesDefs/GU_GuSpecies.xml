<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <!-- Species definitions only. No automatic spawning or gameplay migration. -->
  <ProjectGu.Domain.GuSpeciesDef>
    <defName>GU_HopeGu</defName>
    <label>Hope Gu</label>
    <description>Human Path Gu that congregate around spirit springs. Mature Hope Gu are used in awakening ceremonies.</description>
    <minRank>1</minRank>
    <maxRank>1</maxRank>
    <wildPopulationEnabled>true</wildPopulationEnabled>
    <wildProjectionKind>GU_WildGu</wildProjectionKind>
    <dormantProjectionDef>GU_DormantGu</dormantProjectionDef>
    <refinementBaseWorkTicks>9000</refinementBaseWorkTicks>
    <refinementEssenceCost>12</refinementEssenceCost>
    <refinementResistance>1</refinementResistance>
    <pathTags><li>human</li></pathTags>
    <habitatTags><li>spirit_spring</li></habitatTags>
    <capabilityTags><li>awakening_consumable</li></capabilityTags>
    <role>awakening</role>
    <effectNotes><li>Consumed in the awakening ceremony that opens a mortal's aperture. It grants no technique to a Gu Master.</li></effectNotes>
    <!-- Alpha 5A: no canonical individual diet is established for Hope Gu, so none is invented. Spring ecology and awakening are unchanged. -->
    <feeding>
      <status>NotImplemented</status>
      <note>No individual feeding policy is implemented for Hope Gu. Its spring ecology sustains wild populations; captured Hope Gu are consumed in awakening.</note>
    </feeding>
  </ProjectGu.Domain.GuSpeciesDef>
  <ProjectGu.Domain.GuSpeciesDef>
    <defName>GU_MoonlightGu</defName>
    <label>Moonlight Gu</label>
    <description>Rank one Moon Path Gu that nests beside moon orchids in spirit spring caverns. Once refined and stored in its Gu Master's aperture, it condenses primeval essence into a crescent moonblade.</description>
    <minRank>1</minRank>
    <maxRank>1</maxRank>
    <wildPopulationEnabled>true</wildPopulationEnabled>
    <wildProjectionKind>GU_WildMoonlightGu</wildProjectionKind>
    <dormantProjectionDef>GU_DormantMoonlightGu</dormantProjectionDef>
    <refinementBaseWorkTicks>6000</refinementBaseWorkTicks>
    <refinementEssenceCost>10</refinementEssenceCost>
    <refinementResistance>1</refinementResistance>
    <abilities><li>GU_Moonblade</li></abilities>
    <role>attack</role>
    <pathTags><li>moon</li></pathTags>
    <habitatTags><li>spirit_spring</li><li>moon_orchid</li></habitatTags>
    <capabilityTags><li>active_essence_ability</li></capabilityTags>
    <!-- Alpha 5A. Lore: two moon orchid petals in the morning and two in the evening (four a day), so one meal of two
         petals sustains half a day. Storage, hunger and starvation timings are balance choices, deliberately forgiving. -->
    <feeding>
      <status>Simulated</status>
      <note>Eats moon orchid petals: two in the morning and two in the evening.</note>
      <foods>
        <li>
          <thingDef>GU_MoonOrchidPetals</thingDef>
          <mealCount>2</mealCount>
          <daysPerMeal>0.5</daysPerMeal>
        </li>
      </foods>
      <maxDays>2</maxDays>
      <hungryBelowDays>0.5</hungryBelowDays>
      <initialDays>1.5</initialDays>
      <legacyGraceDays>3</legacyGraceDays>
      <impairAfterStarvingDays>2</impairAfterStarvingDays>
      <terminalAfterStarvingDays>10</terminalAfterStarvingDays>
    </feeding>
  </ProjectGu.Domain.GuSpeciesDef>
  <ProjectGu.Domain.GuSpeciesDef>
    <defName>GU_LiquorWorm</defName>
    <label>Liquor Worm</label>
    <description>Rank one Gu, a plump amber worm that cannot resist the scent of alcohol. Refined and stored in its Gu Master's aperture, it refines that cultivator's primeval essence of the current minor stage into the next higher quality without changing its volume.</description>
    <minRank>1</minRank>
    <maxRank>1</maxRank>
    <wildPopulationEnabled>true</wildPopulationEnabled>
    <wildProjectionKind>GU_WildLiquorWorm</wildProjectionKind>
    <dormantProjectionDef>GU_DormantLiquorWorm</dormantProjectionDef>
    <refinementBaseWorkTicks>7000</refinementBaseWorkTicks>
    <refinementEssenceCost>10</refinementEssenceCost>
    <refinementResistance>1</refinementResistance>
    <abilities><li>GU_LiquorWormRefinement</li></abilities>
    <role>cultivation support</role>
    <encounterLures><li>Beer</li></encounterLures>
    <encounterLureTicks>600</encounterLureTicks>
    <pathTags><li>food</li></pathTags>
    <habitatTags><li>spirit_spring</li></habitatTags>
    <capabilityTags><li>essence_refinement</li></capabilityTags>
    <!-- Alpha 5A. Lore: Liquor Worm drinks wine; a jar of green bamboo wine sustains it about four days. Beer is the
         first available substitute and, as a balance choice, sustains it about two days per bottle. Future wines add
         entries here with their own daysPerMeal. The beer lure is bait and is not counted as a meal. -->
    <feeding>
      <status>Simulated</status>
      <note>Drinks wine. Beer is a poor substitute.</note>
      <foods>
        <li>
          <thingDef>Beer</thingDef>
          <mealCount>1</mealCount>
          <daysPerMeal>2</daysPerMeal>
          <note>A lower-quality substitute for proper wine.</note>
        </li>
      </foods>
      <maxDays>4</maxDays>
      <hungryBelowDays>1</hungryBelowDays>
      <initialDays>2</initialDays>
      <legacyGraceDays>3</legacyGraceDays>
      <impairAfterStarvingDays>2</impairAfterStarvingDays>
      <terminalAfterStarvingDays>10</terminalAfterStarvingDays>
    </feeding>
  </ProjectGu.Domain.GuSpeciesDef>
  <ProjectGu.Domain.GuSpeciesDef>
    <defName>GU_BlackBoarGu</defName>
    <label>Black Boar Gu</label>
    <description>A natural rank-one Strength Path Gu found in surface forests. Its reference value is 600 primeval stones.</description>
    <minRank>1</minRank>
    <maxRank>1</maxRank>
    <wildPopulationEnabled>true</wildPopulationEnabled>
    <wildProjectionKind>GU_WildBlackBoarGu</wildProjectionKind>
    <dormantProjectionDef>GU_DormantBlackBoarGu</dormantProjectionDef>
    <wildCuriosityChancePerHour>0.001</wildCuriosityChancePerHour>
    <pathTags><li>strength</li></pathTags>
    <habitatTags><li>surface</li><li>forest</li></habitatTags>
    <role>Strength Path</role>
    <feeding>
      <status>Simulated</status>
      <note>Feeds on 100 units of raw pork or one whole pig or wild boar corpse every five days.</note>
      <foods>
        <li>
          <thingDef>Meat_Pig</thingDef>
          <exclusiveMeatSources><li>Pig</li><li>WildBoar</li></exclusiveMeatSources>
          <mealCount>100</mealCount>
          <daysPerMeal>5</daysPerMeal>
        </li>
        <li>
          <thingDef>Corpse_Pig</thingDef>
          <daysPerMeal>5</daysPerMeal>
          <stripCorpseFlesh>true</stripCorpseFlesh>
        </li>
        <li>
          <thingDef>Corpse_WildBoar</thingDef>
          <daysPerMeal>5</daysPerMeal>
          <stripCorpseFlesh>true</stripCorpseFlesh>
        </li>
      </foods>
      <maxDays>5</maxDays>
      <requireFullMealSpace>true</requireFullMealSpace>
      <hungryBelowDays>0.04</hungryBelowDays>
      <initialDays>5</initialDays>
      <legacyGraceDays>5</legacyGraceDays>
      <impairAfterStarvingDays>2</impairAfterStarvingDays>
      <terminalAfterStarvingDays>10</terminalAfterStarvingDays>
    </feeding>
  </ProjectGu.Domain.GuSpeciesDef>
  <!-- Development fixture for cohort and individual persistence. -->
  <ProjectGu.Domain.GuSpeciesDef>
    <defName>GU_DevTestSpringGu</defName>
    <label>test spring Gu (developer only)</label>
    <description>Developer-only test species for verifying cohort and individual persistence.</description>
    <minRank>1</minRank>
    <maxRank>1</maxRank>
    <wildPopulationEnabled>true</wildPopulationEnabled>
    <wildProjectionKind>GU_DevTestWildGu</wildProjectionKind>
    <dormantProjectionDef>GU_DevTestDormantGu</dormantProjectionDef>
    <habitatTags><li>spirit_spring</li></habitatTags>
    <capabilityTags><li>development_test</li></capabilityTags>
    <feeding>
      <status>Exempt</status>
      <note>Developer-only persistence fixture; exempt from simulated feeding.</note>
    </feeding>
  </ProjectGu.Domain.GuSpeciesDef>
</Defs>
