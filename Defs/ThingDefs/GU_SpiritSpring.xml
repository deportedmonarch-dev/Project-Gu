<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <!-- These are prototype resources. The spring is placed through the dev spawn menu.
       No random spring spawning or off-map simulation in 0.2.1. -->
  <ThingDef>
    <defName>GU_PrimevalStone</defName>
    <label>primeval stone</label>
    <description>Concentrated primeval energy produced by a spirit spring. Currently a physical resource for future cultivation and trade systems.</description>
    <thingClass>ThingWithComps</thingClass>
    <category>Item</category>
    <selectable>true</selectable>
    <alwaysHaulable>true</alwaysHaulable>
    <graphicData>
      <texPath>Things/Item/Resource/Silver</texPath>
      <graphicClass>Graphic_StackCount</graphicClass>
      <color>(255,235,211)</color>
    </graphicData>
    <stackLimit>200</stackLimit>
    <drawGUIOverlay>true</drawGUIOverlay>
    <statBases>
      <MaxHitPoints>100</MaxHitPoints>
      <Mass>0.1</Mass>
      <MarketValue>30</MarketValue>
      <Flammability>0</Flammability>
    </statBases>
    <thingCategories>
      <li>ResourcesRaw</li>
    </thingCategories>
    <comps>
      <li Class="CompProperties_Forbiddable" />
    </comps>
  </ThingDef>
  <ThingDef ParentName="BuildingBase">
    <defName>GU_SpiritSpring</defName>
    <label>spirit spring (prototype)</label>
    <description>A concentration of primeval energy found in spirit spring caverns. An active spring spends its reserve to produce physical primeval stones. Its local Hope Gu can support natural awakening ceremonies.</description>
    <thingClass>Building</thingClass>
    <graphicData>
      <texPath>ProjectGU/SpiritSpringSeep</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>(2.5,2.5)</drawSize>
    </graphicData>
    <size>(2,2)</size>
    <passability>PassThroughOnly</passability>
    <fillPercent>0.1</fillPercent>
    <tickerType>Rare</tickerType>
    <comps>
      <li Class="ProjectGu.Underground.CompProperties_GuCavernGlower">
        <glowRadius>8.4</glowRadius>
        <glowColor>(62,178,163,0)</glowColor>
      </li>
      <li Class="ProjectGu.Underground.CompProperties_GuBotanicalGlower">
        <glowRadius>19</glowRadius>
        <glowColor>(96,126,175,0)</glowColor>
      </li>
      <li Class="ProjectGu.Springs.CompProperties_GuSpiritSpring">
        <productionIntervalTicks>60000</productionIntervalTicks>
        <stonesPerCycle>1</stonesPerCycle>
        <stoneDefName>GU_PrimevalStone</stoneDefName>
        <regionProfile>SouthernBorder</regionProfile>
        <initialReserve>100000</initialReserve>
        <purityPercent>75</purityPercent>
        <habitatRadius>5</habitatRadius>
        <maxHopeGu>30</maxHopeGu>
        <cavernHabitatRadius>9</cavernHabitatRadius>
        <cavernGrowthIntervalTicks>30000</cavernGrowthIntervalTicks>
        <cavernSupportUnitsPerPoint>5</cavernSupportUnitsPerPoint>
        <cavernMaxFloraSupport>7</cavernMaxFloraSupport>
        <cavernFlora>
          <li><flora>GU_MoonOrchidHabitat</flora><targetPatches>5</targetPatches></li>
          <li><flora>GU_SpiritGrassHabitat</flora><targetPatches>24</targetPatches></li>
        </cavernFlora>
        <botanicalHabitatRadius>16</botanicalHabitatRadius>
        <botanicalCavernFlora>
          <li><flora>GU_MoonOrchid</flora><targetPatches>5</targetPatches></li>
          <li><flora>GU_SpiritGrass</flora><targetPatches>110</targetPatches></li>
        </botanicalCavernFlora>
        <initialCohorts>
          <li><species>GU_MoonlightGu</species><mature>2</mature><juvenile>0</juvenile></li>
          <li><species>GU_LiquorWorm</species><mature>2</mature><juvenile>0</juvenile></li>
        </initialCohorts>
        <!-- Alpha 5B: luminous Hope Gu drifting around the spring, one per living Hope Gu in the cohort, at most 14.
             Scenery derived from the cohort: never individuals, never selectable or capturable. -->
        <ambientSpirits>
          <li>
            <species>GU_HopeGu</species>
            <texPath>ProjectGU/Effects/HopeSpirit</texPath>
            <color>(0.80, 0.93, 1.0, 0.85)</color>
            <perIndividual>1</perIndividual>
            <maxSpirits>14</maxSpirits>
            <radius>3.6</radius>
          </li>
        </ambientSpirits>
      </li>
    </comps>
  </ThingDef>
</Defs>
