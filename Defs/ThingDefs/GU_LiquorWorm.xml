<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <!-- Liquor Worm physical forms. Identity, custody and refinement belong to the generic Gu registry. -->
  <ThingDef ParentName="GU_WildProjectionRace">
    <defName>GU_WildLiquorWorm</defName>
    <label>wild Liquor Worm</label>
    <description>A wild Liquor Worm, a plump amber worm drawn by the scent of alcohol. It recognizes no cultivator until it is captured and refined.</description>
  </ThingDef>
  <PawnKindDef ParentName="GU_WildProjectionKind">
    <defName>GU_WildLiquorWorm</defName>
    <label>wild Liquor Worm</label>
    <race>GU_WildLiquorWorm</race>
    <combatPower>1</combatPower>
    <lifeStages>
      <li>
        <bodyGraphicData>
          <texPath>ProjectGU/Gu/LiquorWorm/Wild</texPath>
          <graphicClass>Graphic_Multi</graphicClass>
          <drawSize>0.8</drawSize>
        </bodyGraphicData>
        <dessicatedBodyGraphicData>
          <texPath>ProjectGU/Gu/LiquorWorm/Wild</texPath>
          <graphicClass>Graphic_Multi</graphicClass>
          <drawSize>0.8</drawSize>
        </dessicatedBodyGraphicData>
      </li>
    </lifeStages>
  </PawnKindDef>

  <ThingDef ParentName="ResourceBase">
    <defName>GU_DormantLiquorWorm</defName>
    <label>dormant Liquor Worm</label>
    <description>A Liquor Worm curled tight and still. Carrying it does not make it recognize its holder as its cultivator.</description>
    <thingClass>ProjectGu.Thing_GuDormantProjection</thingClass>
    <notifyMapRemoved>true</notifyMapRemoved>
    <comps>
      <li Class="ProjectGu.CompProperties_GuManifestation" />
    </comps>
    <stackLimit>1</stackLimit>
    <tickerType>Never</tickerType>
    <alwaysHaulable>true</alwaysHaulable>
    <thingCategories><li>GU_DormantGu</li></thingCategories>
    <tradeability>None</tradeability>
    <graphicData>
      <texPath>ProjectGU/Gu/LiquorWorm/Dormant</texPath>
      <graphicClass>Graphic_Single</graphicClass>
    </graphicData>
    <statBases><Mass>0.1</Mass></statBases>
  </ThingDef>
</Defs>
