<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <ThingDef ParentName="BuildingBase">
    <defName>GU_SpiritGrassHabitat</defName>
    <label>spirit grass patch</label>
    <description>Low tufts of silver-green spirit grass. Wild patches take root in spring-fed ground and provide shelter for local Gu.</description>
    <thingClass>Building</thingClass>
    <tickerType>Never</tickerType>
    <graphicData>
      <texPath>ProjectGU/SpiritGrass</texPath>
      <graphicClass>Graphic_Random</graphicClass>
      <drawSize>(1.48,1.48)</drawSize>
    </graphicData>
    <size>(1,1)</size><passability>Standable</passability><fillPercent>0</fillPercent>
    <statBases><MaxHitPoints>60</MaxHitPoints><Flammability>0.2</Flammability></statBases>
    <building>
      <claimable>false</claimable>
      <expandHomeArea>false</expandHomeArea>
    </building>
    <comps>
      <li Class="ProjectGu.Underground.CompProperties_GuCavernGlower">
        <glowRadius>1.8</glowRadius>
        <glowColor>(31,75,54,0)</glowColor>
      </li>
      <li Class="ProjectGu.Springs.CompProperties_GuSpiritFlora">
        <support>2</support>
        <ecologyProfile>generic</ecologyProfile>
        <cavernSupportUnits>1</cavernSupportUnits>
        <growthSoils><li>SoilRich</li><li>MarshyTerrain</li></growthSoils>
        <waterRange>4</waterRange>
      </li>
    </comps>
  </ThingDef>
</Defs>
