    <statBases><MaxHitPoints>60</MaxHitPoints><Flammability>0.2</Flammability></statBases>
    <comps><li Class="ProjectGu.Springs.CompProperties_GuSpiritFlora"><support>2</support><ecologyProfile>generic</ecologyProfile></li></comps>
  </ThingDef>
</Defs>
