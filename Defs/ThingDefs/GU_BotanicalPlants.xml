<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <ThingDef ParentName="PlantBaseNonEdible">
    <defName>GU_SpiritGrass</defName>
    <label>spirit grass</label>
    <description>Fine silver-green grass that carpets fertile cavern banks and provides shelter for wild Gu.</description>
    <selectable>true</selectable>
    <graphicData>
      <texPath>ProjectGU/SpiritGrassBank</texPath>
      <graphicClass>Graphic_Single</graphicClass>
    </graphicData>
    <statBases>
      <MaxHitPoints>60</MaxHitPoints>
      <Flammability>0.2</Flammability>
    </statBases>
    <plant>
      <growDays>2.5</growDays>
      <growMinGlow>0</growMinGlow>
      <growOptimalGlow>0</growOptimalGlow>
      <minGrowthTemperature>-10</minGrowthTemperature>
      <minOptimalGrowthTemperature>5</minOptimalGrowthTemperature>
      <fertilityMin>0.7</fertilityMin>
      <fertilitySensitivity>0.3</fertilitySensitivity>
      <maxMeshCount>9</maxMeshCount>
      <visualSizeRange>0.25~0.50</visualSizeRange>
      <topWindExposure>0.2</topWindExposure>
      <neverBlightable>true</neverBlightable>
    </plant>
    <comps>
      <li Class="ProjectGu.Springs.CompProperties_GuSpiritFlora">
        <support>0</support>
        <cavernSupportUnits>24</cavernSupportUnits>
        <cavernSupportFullAt>110</cavernSupportFullAt>
        <growthSoils><li>GU_PrimevalQiRichSoil</li><li>MarshyTerrain</li></growthSoils>
      </li>
    </comps>
  </ThingDef>
  <ThingDef ParentName="PlantBaseNonEdible">
    <defName>GU_MoonOrchid</defName>
    <label>moon orchid</label>
    <description>A blue-violet orchid that grows on primeval qi-rich soil even in darkness. It can be sown in growing zones with moon orchid seeds, which are gathered from flowering orchids. Mature flowers can be harvested for their petals without uprooting the plant; the orchid then needs time to regrow before it flowers again.</description>
    <selectable>true</selectable>
    <graphicData>
      <texPath>ProjectGU/MoonOrchid</texPath>
    </graphicData>
    <statBases>
      <MaxHitPoints>60</MaxHitPoints>
      <Flammability>0.25</Flammability>
    </statBases>
    <plant>
      <growDays>5</growDays>
      <growMinGlow>0</growMinGlow>
      <growOptimalGlow>0</growOptimalGlow>
      <minGrowthTemperature>-10</minGrowthTemperature>
      <minOptimalGrowthTemperature>5</minOptimalGrowthTemperature>
      <fertilityMin>0.7</fertilityMin>
      <!-- Alpha 5B: sowing takes crop-like work (vanilla default is 10, i.e. instant). Balance value. -->
      <sowWork>400</sowWork>
      <sowTags><li>Ground</li></sowTags>
      <wildTerrainTags><li>GU_PrimevalQiRich</li></wildTerrainTags>
      <maxMeshCount>1</maxMeshCount>
      <visualSizeRange>0.40~1.15</visualSizeRange>
      <neverBlightable>true</neverBlightable>
      <!-- Alpha 5A petal harvest. Non-destructive: growth falls to harvestAfterGrowth and must climb back above
           harvestMinGrowth before the next harvest, so a single plant cannot be harvested without regrowing.
           0.7 keeps a harvested wild orchid above the 0.65 cavern-lighting threshold. Balance values, not lore. -->
      <harvestedThingDef>GU_MoonOrchidPetals</harvestedThingDef>
      <harvestYield>6</harvestYield>
      <harvestWork>200</harvestWork>
      <harvestTag>Standard</harvestTag>
      <harvestMinGrowth>0.85</harvestMinGrowth>
      <harvestAfterGrowth>0.7</harvestAfterGrowth>
    </plant>
    <comps>
      <li Class="ProjectGu.Springs.CompProperties_GuSpiritFlora">
        <support>0</support>
        <ecologyProfile>moon</ecologyProfile>
        <cavernSupportUnits>3</cavernSupportUnits>
        <growthSoils><li>GU_PrimevalQiRichSoil</li></growthSoils>
        <minimumSpacing>3</minimumSpacing>
      </li>
      <!-- Alpha 5B plant framework: seed-gated cultivation, seed gathering and the Gu food relationship.
           A seed gathering spends the same flowering as a petal harvest (growth back to 0.7, regrow past 0.85). -->
      <li Class="ProjectGu.Botany.CompProperties_GuPlant">
        <category>Flower</category>
        <naturalHabitat>primeval qi-rich soil around spirit springs, even in darkness</naturalHabitat>
        <cultivable>true</cultivable>
        <sowingMaterial>GU_MoonOrchidSeeds</sowingMaterial>
        <sowingMaterialCount>1</sowingMaterialCount>
        <seedCollection>
          <yield>2</yield>
          <work>300</work>
        </seedCollection>
        <harvestRoles><li>GuFood</li></harvestRoles>
        <usesNote>Moon orchid petals are reserved for future Moon Path refinement recipes.</usesNote>
      </li>
    </comps>
  </ThingDef>
</Defs>
