<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <ThingDef ParentName="ResourceBase">
    <defName>GU_DevTestDormantGu</defName>
    <label>dormant test Gu</label>
    <description>The dormant form of the developer test Gu.</description>
    <thingClass>ProjectGu.Thing_GuDormantProjection</thingClass>
    <notifyMapRemoved>true</notifyMapRemoved>
    <comps>
      <li Class="ProjectGu.CompProperties_GuManifestation" />
    </comps>
    <stackLimit>1</stackLimit>
    <tickerType>Never</tickerType>
    <!-- Ordinary hauling and storage move the same authorized Thing without changing custody or allegiance. -->
    <alwaysHaulable>true</alwaysHaulable>
    <thingCategories>
      <li>GU_DormantGu</li>
    </thingCategories>
    <tradeability>None</tradeability>
    <graphicData>
      <texPath>Things/Item/Resource/Silver</texPath>
      <graphicClass>Graphic_StackCount</graphicClass>
    </graphicData>
    <statBases><Mass>0.1</Mass></statBases>
  </ThingDef>
</Defs>
