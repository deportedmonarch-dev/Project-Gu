<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <NuGetAudit>false</NuGetAudit>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../Source/ProjectGu/ProjectGu.csproj" />
    <Reference Include="Assembly-CSharp"><HintPath>$(RimWorldPath)/Assembly-CSharp.dll</HintPath></Reference>
    <Reference Include="Waylith"><HintPath>$(RimWorldPath)/Waylith.dll</HintPath></Reference>
    <Reference Include="UnityStubs"><HintPath>$(RimWorldPath)/UnityStubs.dll</HintPath></Reference>
  </ItemGroup>
  <ItemGroup>
    <!-- Game-independent parts of the M0 TPS probe, compiled here for managed tests. -->
    <Compile Include="../ProjectGu.TpsProbe/TpsStatistics.cs" Link="TpsProbe/TpsStatistics.cs" />
    <Compile Include="../ProjectGu.TpsProbe/TpsConfig.cs" Link="TpsProbe/TpsConfig.cs" />
  </ItemGroup>
</Project>
