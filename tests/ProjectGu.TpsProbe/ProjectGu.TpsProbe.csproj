<Project Sdk="Microsoft.NET.Sdk">
  <!-- Test-only throughput probe. It deliberately has no Project GU reference, so it loads identically in the vanilla
       and Project GU variants of the M0 measurement. It is staged only by scripts/verify-priority0-live.ps1 -Profile Tps. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>ProjectGu.TpsProbe</AssemblyName>
    <RootNamespace>ProjectGu.TpsProbe</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <NuGetAudit>false</NuGetAudit>
    <HarmonyPath Condition="'$(HarmonyPath)' == ''">$(RimWorldPath)/../../workshop/content/294100/2009463077/1.7/Assemblies/0Harmony.dll</HarmonyPath>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="Assembly-CSharp"><HintPath>$(RimWorldPath)/Assembly-CSharp.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityStubs"><HintPath>$(RimWorldPath)/UnityStubs.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="0Harmony"><HintPath>$(HarmonyPath)</HintPath><Private>false</Private></Reference>
  </ItemGroup>
</Project>
